# ============================================================
#  Caddyfile for gabevandevere.com
#  Docs: https://caddyserver.com/docs/caddyfile
#
#  Listens on 127.0.0.1:8081 (plain HTTP). Cloudflare terminates TLS
#  at its edge and cloudflared carries traffic here over an outbound-only
#  tunnel, so this port is not reachable from any network -- not even
#  the LAN. To let Caddy own TLS itself, see the block at the bottom.
#
#  Ports on this machine:
#    8080  llama.cpp (oracle-llm.service)  -- do not touch
#    8000  reserved                        -- do not touch
#    8081  this server
#    8002  site API (api/server.py, site-api.service) -- loopback only
# ============================================================
{
	# Admin API on a unix socket, not a TCP port: nothing on the network
	# can reach it, but `caddy reload` still works for zero-downtime
	# config changes. File permissions are the access control.
	admin unix//home/gabevandevere/.local/share/caddy/admin.sock
	# TLS is handled upstream; don't try to get certificates.
	auto_https off
}

:8081 {
	# Bind to loopback only. NOTE: writing the site address as
	# `127.0.0.1:8081` does NOT do this -- Caddy reads the host part as a
	# Host-header matcher, still listens on all interfaces, and then 400s
	# every request whose Host doesn't literally equal 127.0.0.1.
	# `bind` is the directive that controls the listening interface.
	bind 127.0.0.1

	root * /home/gabevandevere/gabevandevere.com/site

	# Compress text, but NOT text/event-stream: the LLM answers arrive as a
	# live stream and a compressor in the middle would buffer the words.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	# --- security headers -------------------------------------
	header {
		# Don't let other sites frame this one.
		X-Frame-Options "SAMEORIGIN"
		# Don't guess content types.
		X-Content-Type-Options "nosniff"
		# Don't leak full URLs to sites you link to.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Turn off browser APIs the site never uses.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		# Everything loads from this origin only. If you ever add an
		# embed (YouTube, a font CDN), you must widen this or it breaks.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		# Don't advertise the server software.
		-Server
	}

	# --- caching ----------------------------------------------
	# HTML: always revalidate, so edits show up immediately.
	@html path *.html /
	header @html Cache-Control "no-cache"

	# CSS/JS: ten minutes. index.html links them with a ?v= hash from build.py,
	# so a fresh build is picked up on the next page load anyway.
	@code path *.css *.js
	header @code Cache-Control "public, max-age=600"
	# Images and fonts: a day / a year. Fonts never change; images rarely.
	@images path *.svg *.png *.jpg *.webp *.ico
	header @images Cache-Control "public, max-age=86400"
	@fonts path *.woff2
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	# Go's mime table does not know .webmanifest.
	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# --- site API: local LLM proxy + board telemetry ------------
	# The page's "machine" section talks to /api/*. This is NOT :8080
	# directly: that would put an unmetered LLM on the public internet
	# and the API key would have to live where the browser can read it.
	# api/server.py (site-api.service) holds the key, fixes the system
	# prompt, caps tokens, rate-limits, and queues for the single slot.
	#
	# handle_path strips the /api prefix, so the backend sees /chat and
	# /status. flush_interval -1 pushes each streamed token through
	# immediately instead of buffering the response.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8002 {
			flush_interval -1
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# --- static files -----------------------------------------
	file_server

	# --- pretty 404 -------------------------------------------
	handle_errors {
		# handle_errors runs as its own route, so it does NOT inherit the
		# `header` block above. Repeat the important bits here or error
		# pages ship without the security headers.
		header {
			X-Frame-Options "SAMEORIGIN"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
			-Server
		}
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output file /home/gabevandevere/gabevandevere.com/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
	}
}

# ============================================================
#  ALTERNATIVE: let Caddy terminate TLS itself.
#  Only works if inbound :80 and :443 reach this machine
#  (router port-forwarding). Replace the ":8081 {" block above
#  with this, then Caddy gets a Let's Encrypt cert automatically.
#
#  gabevandevere.com, www.gabevandevere.com {
#  	root * /home/gabevandevere/gabevandevere.com/site
#  	encode zstd gzip
#  	file_server
#  }
# ============================================================
