# ===================================================================
#  Caddyfile — gabevandevere.com
#  Verified against Caddy v2.11.4 (caddy validate) on arm64.
#
#  Port map on this box:
#    8080  llama.cpp / oracle-llm.service   <- do not bind
#    8000  reserved, keep free              <- do not bind
#    8081  this static site                 <- ours
# ===================================================================
{
	# Admin API on a unix socket instead of TCP 2019: nothing on the
	# network can reach it, but `caddy reload` still works.
	admin unix//home/gabevandevere/.local/share/caddy/admin.sock

	# No TLS here — this listens on a plain HTTP port behind whatever
	# terminates TLS (tunnel, or a 443 listener). Without this, Caddy
	# would try to provision certs for a bare port and fail.
	auto_https off
}

:8081 {
	root * /home/gabevandevere/gabevandevere.com/site

	# zstd first: clients that speak it get the better ratio, the rest
	# fall back to gzip. Order in the directive = preference order.
	encode zstd gzip

	# ---- security headers -----------------------------------------
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		# Strip the "Server: Caddy" banner. Leading '-' = remove.
		-Server
	}

	# ---- cache policy ---------------------------------------------
	@html path *.html /
	header @html Cache-Control "no-cache"

	@assets path *.css *.js *.svg *.png *.jpg *.webp *.woff2
	header @assets Cache-Control "public, max-age=3600"

	# ---- FUTURE: LLM reverse proxy --------------------------------
	# handle_path (not handle) strips the matched prefix, so
	#   /api/llm/v1/chat/completions  ->  /v1/chat/completions
	# which is exactly the path llama.cpp's OpenAI-compatible API wants.
	# Using plain `handle` here would forward /api/llm/v1/... and 404.
	#
	# The Authorization header is injected server-side from the
	# environment so the API key never reaches the browser. Set it in
	# the systemd unit with:
	#   Environment=ORACLE_LLM_KEY=...   (or EnvironmentFile=)
	#
	# handle_path /api/llm/* {
	# 	reverse_proxy 127.0.0.1:8080 {
	# 		header_up Authorization "Bearer {env.ORACLE_LLM_KEY}"
	# 		# Token generation is slow; don't cut it off mid-stream.
	# 		transport http {
	# 			read_timeout 300s
	# 		}
	# 	}
	# }

	# ---- static files ---------------------------------------------
	file_server

	# ---- custom 404 -----------------------------------------------
	# handle_errors runs as a separate route and does NOT inherit the
	# `header` block above, so repeat the headers you care about.
	# file_server inside handle_errors preserves the 404 status code.
	handle_errors 404 {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
			-Server
		}
		rewrite * /404.html
		file_server
	}

	# Everything that is not a 404 (500s, etc.) gets a plain response.
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output file /home/gabevandevere/gabevandevere.com/logs/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
	}
}
